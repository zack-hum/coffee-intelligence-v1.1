# Normalize text files to LF in the repo; check out with the platform default.
* text=auto eol=lf

# Windows batch files break (labels/goto) with LF endings.
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell scripts must stay LF to run on macOS/Linux.
*.sh text eol=lf

# Vendored, minified third-party bundle: don't diff or count it.
app/static/lightweight-charts.standalone.production.js -diff linguist-vendored

*.db binary
*.png binary
*.jpg binary
