# Local settings. Copied to .env on first run; .env is not deployed.
# The command line wins over this file: `./dev.sh live` sets APP_MODE=live.

# demo = offline synthetic data · live = real sources, local archive
APP_MODE=demo

# Seconds between drip-fed demo headlines (demo mode)
DEMO_DRIP_SECONDS=45

# Live mode schedule (seconds): news every 15 min, datasets every 6 h
NEWS_EVERY=900
DATA_EVERY=21600

# Optional free keys (live mode)
#   USDA supply & demand: https://apps.fas.usda.gov/opendatawebv2/#/signup
FAS_API_KEY=
#   US Census trade data (required for the US imports charts): https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# Set to require a password locally too (any username)
DASH_PASSWORD=
